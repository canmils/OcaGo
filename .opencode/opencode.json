{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chrome"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "node *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "bash *": "allow"
    }
  }
}
